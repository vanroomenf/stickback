{
  "name": "Stickback",
  "short_name": "Stickback",
  "description": "Racconta un problema. Ti rispondono solo con sticker.",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1a1622",
  "theme_color": "#1a1622",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "stickers", "accept": ["image/*", ".webp", ".png", ".gif", ".jpg", ".jpeg"] }
      ]
    }
  }
}
