{
  "expo": {
    "name": "Stickback",
    "slug": "stickback",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1622",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stickback uses your photos to add your stickers."
        }
      ],
      "expo-localization",
      "expo-notifications"
    ],
    "scheme": "stickback",
    "backgroundColor": "#1a1622",
    "experiments": {
      "baseUrl": "/stickback/app"
    },
    "locales": {
      "it": "./locales/it.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json"
    }
  }
}
