{
  "expo": {
    "name": "Stickback",
    "slug": "stickback",
    "owner": "vanroomenfs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "bundleIdentifier": "app.stickback",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1622",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "app.stickback",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stickback uses your photos to add your stickers.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-notifications"
    ],
    "scheme": "stickback",
    "backgroundColor": "#1a1622",
    "experiments": {
      "baseUrl": "/stickback/app"
    },
    "locales": {
      "it": "./locales/it.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json"
    },
    "extra": {
      "eas": {
        "projectId": "bf62fb88-8c1c-4319-8bb5-afab41d1528c"
      }
    }
  }
}
